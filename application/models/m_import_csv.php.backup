    {
        // This can be enhanced to lookup from master_losstime table
        $categories = [
            'Adjust Parameter' => 'Setting',
            'Pre Heating Material' => 'Material',
            'Cleaning Hopper & Barrel' => 'Maintenance',
            'Set Up Mold' => 'Setting',
            'Set Up Parameter Machine' => 'Setting',
            'IPQC Inspection' => 'Quality',
            'No Packing' => 'Material',
            'No Material' => 'Material',
            'Material Problem' => 'Material',
            'No Operator' => 'Manpower',
            'Daily Checklist' => 'Maintenance',
            'Overhoule Mold' => 'Maintenance',
            'Mold Problem' => 'Machine',
            'Trial' => 'Setting',
            'Machine' => 'Machine',
            'Hopper Dryer' => 'Machine',
            'Robot' => 'Machine',
            'MTC' => 'Maintenance',
            'Cooling Tower' => 'Machine',
            'Compressor' => 'Machine',
            'Listrik' => 'Utility',
            'QC Lolos' => 'Quality',
            'Set Up Awal' => 'Setting',
        ];

        return isset($categories[$nama]) ? $categories[$nama] : 'Other';
    }
}
