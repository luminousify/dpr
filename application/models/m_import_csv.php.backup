            'Crack' => 'Process',
            'Dent' => 'Appearance',
            'Dirty' => 'Appearance',
            'Discolour' => 'Appearance',
            'Ejector Mark' => 'Process',
            'Flash' => 'Process',
            'Flow Gate' => 'Process',
            'Flow Mark' => 'Process',
            'Foreign Material' => 'Material',
            'Gas Burn' => 'Process',
            'Gas Mark' => 'Process',
            'Gate Bolong' => 'Process',
            'Gate Long' => 'Process',
            'Hangus' => 'Process',
            'Hike' => 'Process',
            'Oil' => 'Material',
            'Oversize' => 'Dimension',
            'Pin Plong' => 'Process',
            'Pin Seret' => 'Process',
            'Scratch' => 'Appearance',
            'Settingan' => 'Process',
            'Short Shoot' => 'Process',
            'Silver' => 'Appearance',
            'Sink Mark' => 'Appearance',
            'Undercut' => 'Process',
            'Undersize' => 'Dimension',
